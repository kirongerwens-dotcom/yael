# Public Firebase web configuration, NOT a service account or Admin SDK credential.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# A production allowlist is required; localhost and Vite dev are always excluded.
VITE_ANALYTICS_PRODUCTION_HOSTS=kirongerwens-dotcom.github.io
# Tracking still requires an affirmative visitor decision and configured privacy contact.
VITE_ANALYTICS_ENABLED=true
# Full name and reachable contact details of the controller; shown in privacy information.
VITE_PRIVACY_CONTACT=
# Optional local admin demo only; ignored by production builds. Project must be demo-yael.
VITE_FIREBASE_USE_EMULATORS=false
